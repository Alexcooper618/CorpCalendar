{
  "name": "csi-calendar-backend",
  "version": "1.0.0",
  "main": "dist/main.js",
  "scripts": {
    "build": "npm run clean && npm run prisma:generate && nest build",
    "prestart": "npm run prisma:generate",
    "start": "nest start",
    "prestart:dev": "npm run clean && npm run prisma:generate",
    "start:dev": "nest start --watch",
    "clean": "rm -rf dist tsconfig.tsbuildinfo",
    "prisma:migrate": "prisma migrate dev --name init"
  },
  "dependencies": {
    "@nestjs/common": "^10.0.0",
    "@nestjs/core": "^10.0.0",
    "@nestjs/platform-express": "^10.0.0",
    "@prisma/client": "^5.0.0",
    "reflect-metadata": "^0.1.13",
    "rxjs": "^7.8.0"
  },
  "devDependencies": {
    "@nestjs/cli": "^10.0.0",
    "@nestjs/schematics": "^10.0.0",
    "@nestjs/testing": "^10.0.0",
    "@types/node": "^20.0.0",
    "prisma": "^5.0.0",
    "ts-node": "^10.9.1",
    "typescript": "^5.4.0"
  }
}
